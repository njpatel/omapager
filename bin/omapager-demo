#!/usr/bin/env python3
# omapager-demo - a realistic run of notifications, for looking at the thing.
#
#   omapager-demo              the default scene, paced for watching
#   omapager-demo --fast       same scene, tighter, for a recording
#   omapager-demo --scene chat only one part of it
#   omapager-demo --scene interactive   codes, links and the sender's buttons
#   omapager-demo --scene routing       where a click sends you, per source
#   omapager-demo --scene reply         inline reply, against a stand-in phone
#   omapager-demo --list       what scenes there are
#   omapager-demo --loop       keep going until interrupted
#
# The senders here are the ones that actually notify this desktop - Chrome
# announcing a web app through a leading anchor, KDE Connect naming a device in
# the summary, a terminal, a backup job - because those shapes are what the
# grouping and the markup parsing have to cope with. The words are invented;
# nothing here is anybody's real message.
import argparse
import json
import os
import random
import subprocess
import sys
import time

STORE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "omapager-store")

# Chrome puts a link to the origin on the front of every web notification, and
# that anchor is what tells app.slack.com apart from mail.google.com.
def web(host, body):
    return '<a href="https://%s/">%s</a>\n\n%s' % (host, host, body)


SCENES = {
    # People. Chrome announces a web app through a leading anchor, and that
    # anchor is the only thing that tells app.slack.com from web.whatsapp.com -
    # both of them are "Google Chrome" as far as the bus is concerned.
    "chat": [
        dict(web="app.slack.com", summary="#design",
             body="Gurbinder: new spacing is in Figma, worth a look before standup"),
        dict(web="web.whatsapp.com", summary="Seif Lotfy",
             body="I have to show you this thing I built, are you around later?"),
        dict(web="app.slack.com", summary="Dominic",
             body="can you sanity check the quota panel numbers?"),
        dict(web="x.com", summary="Elon Musk",
             body="replied to your post: this is the part everyone gets wrong"),
        # A channel going off. Four from one source, arriving faster than the
        # scene's pace, so the stack builds in front of you - which is the
        # thing worth watching and the thing a one-notification-per-source
        # demo never shows.
        dict(web="app.slack.com", summary="#design", gap=0.7,
             body="Gurbinder: pushed the spacing pass, take a look"),
        dict(web="app.slack.com", summary="#design", gap=0.7,
             body="Dominic: the two-line ones finally breathe"),
        dict(web="app.slack.com", summary="#design", gap=0.7,
             body="Gurbinder: one more go at the icon size and I think that is it"),
        dict(web="app.slack.com", summary="#design",
             body="Dominic: shipping it before standup then"),
    ],
    # Work: the things that arrive while you are in the middle of something.
    "work": [
        dict(web="linear.app", summary="AXM-412 assigned to you",
             body="Deck stutters when a notification lands during hover"),
        dict(web="github.com", summary="Review requested",
             body="axiomhq/axiom-web #1841 - <b>tighten the toast layout</b>"),
        dict(app="kitty", icon="kitty", summary="Tests passed",
             body="412 passed, 0 failed in <b>2m 14s</b>"),
        dict(web="app.slack.com", summary="#releases",
             body="0.43 tagged and pushed"),
    ],
    # The machine talking about itself. Named after things this desktop
    # actually has an icon for - a notification with a letter tile in a demo
    # reads as a bug rather than as a fallback.
    "system": [
        dict(app="Omarchy", icon="system-software-update", summary="Updates available",
             body="14 packages, including linux 6.17.4 and hyprland 0.52"),
        dict(app="Snapshots", icon="LimineSnapperSync", summary="Snapshot complete",
             body="pre-update root snapshot written in 4s"),
        dict(app="ApexShot", icon="apexshot", summary="Screenshot saved",
             body="~/Screenshots/ApexShot-2026-09-03_22-41-08.png"),
    ],
    # The interactive one: everything a card can offer you, and the shapes that
    # must NOT offer anything. A Slack message with a link, a bank code, a
    # phone number, a forwarded message carrying the phone's own Reply and
    # Mark as read - then a build number, an issue reference and a version,
    # which should stay plain. If any of those last three grows a button, the
    # detector has regressed.
    # Filled in at run time by routing_scene(): which sites have a window open
    # is not something that can be written down in advance.
    "routing": [],
    # Also filled in at run time: it has to write the stand-in phone first.
    "reply": [],
    "interactive": [
        dict(web="app.slack.com", summary="#design",
             body="Gurbinder: latest build is up, take a look https://axiom.co/preview/1841"),
        dict(web="app.slack.com", summary="Bank",
             body="Your verification code is 482913. Do not share it with anyone."),
